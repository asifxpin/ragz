# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Required: the deep agent's chat model and the retrieval embeddings.
OPENAI_API_KEY=

# Required: Scribe v2 Realtime (STT) and Flash v2.5 (TTS).
ELEVENLABS_API_KEY=

# Optional: chat model override. Defaults to gpt-5.5.
# OPENAI_MODEL=gpt-5.5

# Optional: TTS voice. Defaults to 21m00Tcm4TlvDq8ikWAM.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
